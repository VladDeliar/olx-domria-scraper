# Copy this to `.env` (which is gitignored) and fill in values.

# --- Django ---
# Generate a random one for production: `python -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Pick one. docker-compose overrides this via service env (uses `postgres` hostname).
# Local dev without Docker:
DATABASE_URL=sqlite:///db.sqlite3
# Local dev with Postgres on host:
#DATABASE_URL=postgresql://radar:radar@localhost:5432/radar

# --- Postgres (consumed by the `postgres` service in docker-compose) ---
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar

# --- Telegram bot ---
# Get a token from @BotFather: /newbot
TELEGRAM_BOT_TOKEN=

# --- Celery / Redis ---
# Local dev: install Memurai (`winget install Memurai.MemuraiDeveloper`) or run Redis.
# docker-compose overrides these to `redis://redis:6379/...` via service env.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
